    <!-- title of the app -->
    <string name="app_name" translatable="false">NotificationLog</string>

    <!-- title for the app list (single pane mode) -->
    <string name="title_app_list">التطبيقات</string>

    <!-- description for clear history action -->
    <string name="action_clear">مسح السجل</string>

    <!-- dialog: clear history -->
    <string name="dialog_clear_all_title">مسح سجل كل التطبيقات؟</string>
    <string name="dialog_clear_app_title">مسح سجل <xliff:g example="GMail" id="app">%1$s</xliff:g>؟</string>
    <string name="dialog_clear_text">لا يمكن التراجع عن هذا الإجراء</string>
    <string name="dialog_clear_positive">مسح</string>
    <string name="dialog_clear_negative">إلغاء</string>

    <!-- text if there aren't any notifications saved -->
    <string name="notification_list_empty">لا توجد أي إشعارات محفوظة بعد</string>

    <!-- card which says how to enable the notification logging -->
    <string name="card_enable_service_title">الصلاحية مطلوبة</string>
    <string name="card_enable_service_text">
        يحتاج NotificationLog صلاحيتك للوصول إلى إشعاراتك وحفظها.
        تُحفظ البيانات في جهازك فقط ولا تُرسل إلى أي مكان.
    </string>
    <string name="card_enable_service_button">سماح</string>

    <!-- accessibility service dialog -->
    <string name="dialog_accessibility_service_title">خدمة إمكانية الوصول</string>
    <string name="dialog_accessibility_service_text">كان NotificationLog
        سيستخدم صلاحية الوصول إلى الإشعارات لو كان جهازك يدعمها،
        لكن جهازك لا يدعمها. لذلك يمكن لـ NotificationLog استخدام
        صلاحية خدمة إمكانية الوصول بدلًا منها. يستخدمها فقط لقراءة
        الإشعارات وحفظها - حسب إعداداتك - في جهازك.
    </string>
    <string name="dialog_accessibility_service_yes">منح الصلاحية</string>
    <string name="dialog_accessibility_service_no">إلغاء</string>

    <!-- card which informs that logging was disabled for one App -->
    <string name="card_logging_disabled_title">تم إيقاف التسجيل لـ %s</string>
    <string name="card_logging_disabled_text">تقدر تغيّر هذا من القائمة</string>

